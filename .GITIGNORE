cat > .gitignore << 'EOF'
# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Node
node_modules/
.npm
package-lock.json
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
.docker/

# Logs
logs/
*.log

# Database
*.db
pgdata/

# Temporary
temp/
tmp/
*.tmp
EOF
